n = int(input("Ingrese un número para determinar la cantidad de divisores perfectos que tiene: "))

perfectos = 0

for i in range(2,10000,4):

    if n % i == 0:

        comunes = 0

        for j in range(1, i):

            if i % j == 0:
                comunes = comunes + j

        if comunes == i:
            perfectos = perfectos + 1

print("El número tiene", perfectos, "divisores perfectos.")
